// Errors - throw a value, catch it as one. finally always runs.

try {
    throw "bad input"
} catch (ex) {
    print("caught:", gettype(ex))
} finally {
    print("cleaned up")
}

// throw from any depth is caught at any depth above:
function divide(int a, int b) int {
    if (b == 0) {
        throw "division by zero"
    }
    return a / b
}

// A clean call runs and its result is used:
try {
    print(divide(6, 3))
} catch (ex) {
    print("caught:", gettype(ex))
}

// A throwing call is intercepted before it reaches main:
try {
    print(divide(5, 0))
} catch (ex) {
    print("caught:", gettype(ex))
}
